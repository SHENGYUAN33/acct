# AcctAssist — GCP 生產環境變數範本
# 複製為 .env.production 並填入真實值後，存入 GCP Secret Manager：
#   gcloud secrets create acctassist-env-production --data-file=.env.production
#
# ⚠️ .env.production 不得 commit 到 git（已加入 .gitignore）

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=acctassist
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=acctassist

# ── Database URL ────────────────────────────────────────────────────
# 指向 VM 本機（Docker 容器對外綁定 127.0.0.1:5432）
DATABASE_URL=postgresql://acctassist:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/acctassist

# ── JWT ─────────────────────────────────────────────────────────────
# 使用 openssl rand -hex 32 產生
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
JWT_EXPIRE_MINUTES=480

# ── LINE Messaging API ───────────────────────────────────────────────
# 從 LINE Developers Console → Bot Channel → Messaging API 取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Google Gemini API ────────────────────────────────────────────────
# 從 https://aistudio.google.com/apikey 取得
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── App ─────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
STORAGE_PATH=/app/uploads
MAX_UPLOAD_BYTES=10485760

# ── CORS ─────────────────────────────────────────────────────────────
# 填入你的正式網域（JSON array 格式）
CORS_ORIGINS=["https://YOUR_DOMAIN"]

# ── Feature Toggles ─────────────────────────────────────────────────
# ⚠️ ENABLE_AUTO_SPLIT 必須保持 false（單 Worker 限制）
ENABLE_AUTO_SPLIT=false
AUTO_SPLIT_DEBOUNCE_SECONDS=60

ENABLE_LINE_PUSH_REJECT=true
ENABLE_USER_BINDING=true
ENABLE_ROSTER_BINDING=false
ENABLE_WAITING_RETURN_TEXT_MODE=false
ENABLE_WAITING_RETURN_LIFF_BUTTON=false

LIFF_SUBMIT_MODE=single

ENABLE_SCHEDULED_BATCH=false
SCHEDULED_BATCH_TIMES=["20:00"]
SCHEDULED_BATCH_TIMEZONE=Asia/Taipei

# ── 部門清單 ──────────────────────────────────────────────────────────
DEPARTMENTS=["製片組_一般","製片組_場景","美術組_一般","美術組_置景","美術組_陳設","美術組_道具","造型組_梳化","造型組_服裝","演員管理組","特化組","特效組","攝影組","燈光組","場務組","收音組","劇本組","導演組","演員組","航拍組","檔案管理組","後期剪輯","後期特效","公司組"]

# ── OCR 參數 ──────────────────────────────────────────────────────────
OCR_MAX_CONCURRENT=3
OCR_MAX_RETRIES=3
KEY_FIELD_CONFIDENCE_THRESHOLD=0.8
LIFF_SESSION_TTL_MINUTES=30
ORPHAN_WINDOW_MINUTES=10
EXPENSE_EXPORT_LIMIT=10000

# ── 前端 VITE 參數 ──────────────────────────────────────────────────────────
VITE_API_TIMEOUT_MS=15000
VITE_OCR_TIMEOUT_MS=120000

# ── Docker image tag (由 CI/CD 自動注入，手動部署時填入) ──────────────
# BACKEND_IMAGE=asia-east1-docker.pkg.dev/YOUR_PROJECT_ID/acctassist/backend:latest
