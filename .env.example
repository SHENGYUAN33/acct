# ===== Database =====
DATABASE_URL=postgresql://acctassist:acctassist@localhost:5432/acctassist

# ===== LINE Messaging API =====
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ===== Google Gemini API =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ===== Storage =====
# Local path to save uploaded invoice images（STORAGE_BACKEND=local 時使用）
STORAGE_PATH=./uploads
# 儲存後端：local（本機磁碟，開發用）/ gcs（Cloud Run 使用 Google Cloud Storage）
STORAGE_BACKEND=local
# GCS bucket 名稱（STORAGE_BACKEND=gcs 時必填）
GCS_BUCKET=

# ===== JWT =====
# 請在正式環境換成隨機長字串（openssl rand -hex 32）
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_MINUTES=480

# ===== App =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
# 公司統一編號（顯示於 Dashboard Header）
COMPANY_TAX_ID=
# Cloud Scheduler 呼叫 /api/v1/admin/cleanup-liff 的共享密鑰（空字串 = 停用該端點）
CLEANUP_TOKEN=

# ===== CORS（production 時填入前端 URL，多個以逗號分隔）=====
# CORS_ORIGINS=["https://your-frontend.com"]

# ===== Upload Limits =====
# MAX_UPLOAD_BYTES=10485760  # 10MB

# ===== Feature Toggles =====
# 退回推播開關：設為 false 時，退回 API 只更新 DB，不發送 LINE 推播
ENABLE_LINE_PUSH_REJECT=true
# 首次使用身分綁定開關：設為 false 可跳過綁定流程，維持舊有 LINE 暱稱邏輯
ENABLE_USER_BINDING=true
# 管理員帳號建立開關：初次部署建立第一個帳號時設為 true，完成後立即改回 false
ENABLE_REGISTER=true
# 功能開關：員工名冊預綁定（true=啟用，false=維持舊流程）
ENABLE_ROSTER_BINDING=false

# LIFF 送出模式：single（每次送出一律建 1 筆）或 batch（依憑證斷點切割成多筆）
LIFF_SUBMIT_MODE=single

# 待退貨功能開關
# Mode 1：備註文字偵測 — 備註含「待退貨 AB-12345678」格式，自動標記為退貨補件
ENABLE_WAITING_RETURN_TEXT_MODE=false
# Mode 2：LIFF 顯式按鈕 — LIFF 確認頁顯示「此上傳為退貨物品照」toggle
ENABLE_WAITING_RETURN_LIFF_BUTTON=false

# ===== 部門清單 =====
# 逗號分隔，修改後重啟服務即生效，不需重新部署
DEPARTMENTS=["製片組_一般","製片組_場景","美術組_一般","美術組_置景","美術組_陳設","美術組_道具","造型組_梳化","造型組_服裝","演員管理組","特化組","特效組","攝影組","燈光組","場務組","收音組","劇本組","導演組","演員組","航拍組","檔案管理組","後期剪輯","後期特效","公司組"]
# 帳號角色清單（員工名冊下拉選單用），逗號分隔或 JSON array
ACCOUNT_ROLES=["一般員工","管理員"]

# ===== OCR 參數 =====
# 最多同時送出幾個 Gemini 請求（避免 RPM 429），預設 3
OCR_MAX_CONCURRENT=3
# OCR 失敗後最多重試幾次（含第一次，指數退避），預設 3
OCR_MAX_RETRIES=3
# 關鍵稽核欄位信心閾值：低於此值自動標為 NEEDS_MANUAL_REVIEW（0.0–1.0）
KEY_FIELD_CONFIDENCE_THRESHOLD=0.8
# LIFF 上傳 Session 過期時間（分鐘），預設 30
LIFF_SESSION_TTL_MINUTES=30
# 孤立物品圖向前關聯的時間視窗（分鐘），預設 10
ORPHAN_WINDOW_MINUTES=10
# CSV 匯出單次最多筆數上限，預設 10000
EXPENSE_EXPORT_LIMIT=10000

# ===== Dashboard 功能按鈕開關（VITE_ 前綴，前端讀取，改後需重新 vite build / 重啟 dev server）=====
# API 全域 timeout（毫秒），預設 15000
VITE_API_TIMEOUT_MS=15000
# OCR 重新辨識 timeout（毫秒），需大於全域 timeout，預設 120000
VITE_OCR_TIMEOUT_MS=120000
# Dashboard 費用清單預設每頁筆數，預設 100
VITE_DEFAULT_PAGE_SIZE=100
# 疑似重複憑證偵測按鈕：篩選並裁決重複上傳的憑證
VITE_ENABLE_DUPLICATE_DETECTION=true
